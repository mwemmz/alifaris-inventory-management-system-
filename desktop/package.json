{
  "name": "alifaris-desktop",
  "version": "1.0.0",
  "description": "Desktop shell for Alifaris ERP",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:pos": "cross-env ALIFARIS_MODE=pos electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.alifaris.erp",
    "productName": "Alifaris ERP",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "config.json",
      "icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist-server/alifaris-server",
        "to": "server"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}