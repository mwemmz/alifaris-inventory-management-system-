{
  "name": "alifaris-desktop",
  "version": "0.1.0",
  "description": "Desktop shell for Alifaris ERP",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:pos": "cross-env ALIFARIS_MODE=pos electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.alifaris.erp",
    "productName": "Alifaris ERP",
    "win": { "target": "nsis" }
  }
}
